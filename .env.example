# Copy to .env (never commit .env)
DATABASE_URL=postgresql+psycopg://finapp:finapp@localhost:5432/finapp
CORS_ORIGINS=http://localhost:3000
# Admin endpoints (/api/admin/*) are DISABLED unless set. Use a long random value.
ADMIN_TOKEN=
# Free key (recommended): https://fred.stlouisfed.org/docs/api/api_key.html  -> enables true point-in-time vintages
FRED_API_KEY=
# SEC requires a real contact in the User-Agent: "AppName you@example.com"
SEC_USER_AGENT=FinIntel research-app your-email@example.com
STOOQ_API_KEY=
ALPHAVANTAGE_API_KEY=
# Optional (research assistant, not implemented yet)
ANTHROPIC_API_KEY=
